# ==========================================
# 1. Server & Core Configuration
# ==========================================
PORT=5000
NODE_ENV=development
APP_NAME=OIKYO-Enterprise-Platform
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ==========================================
# 2. Database (MongoDB)
# ==========================================
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/oikyo_commerce?retryWrites=true&w=majority

# ==========================================
# 3. Upstash Redis Configuration (AI Caching & State)
# ==========================================
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# ==========================================
# 4. Security & Encryption (AES-256 for AI API Keys)
# Must be a 64-character hex string
# ==========================================
AI_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ==========================================
# 5. JWT Authentication Secrets
# ==========================================
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# ==========================================
# 6. Third-Party Integrations
# ==========================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

RESEND_API_KEY=your_resend_api_key

FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_SERVICE_ACCOUNT={"type":"service_account"}
